{
  "version": "1.0.0",
  "anchor": "Median (full-time, formal-sector + informal-uplift) monthly gross wage per country, in USD-equivalent at 2026 mid-year. Each value reflects what a typical local worker reports as monthly gross pay, including informal-economy uplift where the shadow economy is large (Schneider 2010-2024 shadow-economy estimates). Sources for tier-A (hand-anchored top-60) include national statistical agencies (INSTAT AL, GUS PL, IBGE BR, INEGI MX, BLS US, ONS GB, INSEE FR, Destatis DE, ISTAT IT, Rosstat RU, MOSPI IN, NBS CN, INSTAT TR, RZS RS, NSI BG, INS RO, CSO CZ, KSH HU, DANE CO, Geostat GE, KCSO KE, NBS NG, StatsSA ZA, IBGE BR, INEI PE, INE ES PT, CBS NL, CSO IE, SCB SE, SSB NO, DST DK, FSO CH, etc.), International Labour Organization wage database, and OECD avg wage stats. Tier-B/C countries are anchored from World Bank GNI per capita × labor-share × informal-economy correction. Values are 2024-2025 anchors with country-specific nominal wage growth applied to 2026 (per-region growth assumptions documented in the methodology doc 2026-05-26-wage-quality-overhaul.md). Numbers represent gross monthly earnings, not take-home. Replace data/economic_indicators/country_profile_v2.json median_wage_full_time_usd via scripts/data/recompute_wages_from_median.ts.",
  "convention": {
    "unit": "USD per month",
    "kind": "median_gross_monthly_wage_full_time_with_informal_uplift",
    "as_of_year": 2026,
    "source_quality": {
      "A": "Hand-anchored from a national statistics agency publication or ILO wage database within 24 months",
      "B": "Anchored from secondary source (OECD aggregate, regional cluster median) or 24-48 months old",
      "C": "GDP-per-capita-derived using labor share + informal-economy uplift; no direct wage observation"
    }
  },
  "quality_checks": {
    "min_wage_usd_monthly": 50,
    "max_wage_usd_monthly": 15000,
    "min_wage_to_gdp_per_capita_ratio": 0.40,
    "max_wage_to_gdp_per_capita_ratio": 1.80,
    "informal_uplift_cap_pct": 0.40
  },
  "default_fallback": {
    "median_monthly_wage_usd": 400,
    "source_quality": "C",
    "notes": "Generic emerging market default"
  },
