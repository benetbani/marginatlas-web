{
  "version": "1.1.0",
  "anchor": "Phase 1b + Phase 3 expansion of the commuter+tourism+anomaly-tag framework. See docs/strategy/2026-05-25-COMMUTER-TOURISM-NEIGHBORHOOD-FRAMEWORK.md. Keyed by city_slug.neighborhood_slug. Numbers approximated from public stats offices (US LEHD, UK ONS, FR INSEE, JP e-Stat, DE Destatis) plus city tourism boards. Refresh annually.",
  "convention": {
    "commuter_intensity": "daytime_population / nighttime_residential_population",
    "tourism_intensity": "annual_visitors_per_resident (overnight + day-trippers)",
    "tags": "array of anomaly tags from the 13-tag system",
    "primary_tag": "the most decision-relevant tag for badge display",
    "source_quality": "A = block-level stats, B = district-level, C = estimate from city tier"
  },
  "tag_definitions": {
    "financial_cbd": "Banking + corporate HQ density; lunch + B2B services dominate",
    "tourist_zone": "Annual tourist count > 10x resident pop",
    "luxury_district": "Median household wealth top decile + retail rent top 5%",
    "free_economic_zone": "Special tax + customs regime",
    "university_district": "Full-time students > 15% of resident pop",
    "industrial_park": "Manufacturing payroll > 50% of district",
    "tech_corridor": "Software/IT payroll density + high tertiary education",
    "embassy_quarter": "Foreign mission + expat consulate density",
    "medical_cluster": "Hospital + clinic density > 25% of payroll",
    "transit_hub": "Daily transit pop > 200K",
    "gentrifying_edge": "Rents climbing >10% YoY for 3+ years",
    "nightlife_zone": "Bar + club density top 5%, weekend foot 2x weekday",
    "religious_pilgrimage": "Annual pilgrim count > 100K AND > 10x resident pop",
    "residential_only": "Default - no special tags apply"
  },
