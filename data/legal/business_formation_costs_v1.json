{
  "version": "1.1.0",
  "anchor": "Cities sec 6 founder revision. Per-country business formation costs by legal tier for non-financial SMBs (under 250 employees, EU SME definition). Global category names first (Freelancer, Sole Trader, LLC, Joint-Stock); local term in parentheses where the country uses a distinct name. Cost figures in USD-equivalent of mandatory government and notary fees (no professional fees on top). setup_days is a typical online filing turnaround for the registered office. complexity_score is 1 to 5 where 1 is a 15-minute online filing and 5 is lawyer plus notary plus multiple agency visits plus multi-week wait. Excludes wealth-fund and hedge-fund vehicles (Cayman, BVI, Bermuda, SOPARFI, ETVE, VCC, ICAV, fund limited partnerships, trusts, holding-only entities) per founder direction. Sources: government registries (gov.uk, service-public.fr, IHK, MISE, KvK, ASIC, USPTO state filings, Receita Federal, SAT, MCA, ROCs), Chambers of Commerce, and World Bank Doing Business archive 2003 to 2019.",
  "tier_definitions": {
    "Freelancer": "Self-employed without a separate legal entity. Personal income tax applies. Personal liability is unlimited. Often a simplified tax regime is available.",
    "Sole Trader": "Registered personal business name with the commercial registry; required above a revenue threshold in some countries. Personal liability is still unlimited unless paired with a limited-liability vehicle.",
    "LLC": "Limited Liability Company. Personal liability shielded; profits flow through or are taxed at corporate rate depending on jurisdiction.",
    "Joint-Stock": "Stock-issuing company with separate legal personality. Heavier reporting; typical for businesses planning to raise capital or already operating at the upper SMB end."
  },
  "complexity_legend": {
    "1": "Online filing in under an hour, no notary, no capital, no in-person visit.",
    "2": "Online filing in a day, minor documentation, no notary required.",
    "3": "Multi-step process, registered office and tax registration required, can finish in a week or two.",
    "4": "Notary or court involvement, minimum capital, signed articles, expect three to six weeks.",
    "5": "Lawyer plus notary plus multiple agency visits, capital deposit, multi-week wait, often two months or more."
  },
