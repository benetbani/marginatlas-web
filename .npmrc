# Plan v30 critical fix — pin install behavior so Vercel reproduces local.
#
# Why: react-simple-maps 3.0.0 declares a peer dep on React 17/18.
# Atlas runs React 19 RC. Without legacy-peer-deps Vercel's npm install
# fails with ERESOLVE every time, causing every deploy from commit
# 50b600b onward to fail before the build even starts.
#
# This file makes Vercel's install identical to the working local
# install pattern (npm install --legacy-peer-deps).
legacy-peer-deps=true
