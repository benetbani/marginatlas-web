        "figureLabel": { "type": "string", "minLength": 5 },
        "figureSource": {
          "type": "string",
          "minLength": 3,
          "description": "Dotted path of the canonical field this band restates, so a checker can prove the two agree."
        }
      },
      "additionalProperties": false
    },

    "next": {
      "type": "object",
      "required": ["tiles"],
      "properties": {
        "tiles": {
          "type": "array",
          "minItems": 4,
          "description": "The mockup prints six. Below four the grid breaks its rhythm.",
          "items": { "$ref": "#/definitions/nextTile" }
        }
      },
      "additionalProperties": false
    }
