          "additionalProperties": false
        },
        "archetypes": {
          "oneOf": [
            { "$ref": "#/definitions/archetypesFigure" },
            { "$ref": "#/definitions/nullFigure" }
          ]
        }
      },
      "additionalProperties": false
    },

    "spaceCosts": {
      "type": "object",
      "required": ["costSplit", "sizes", "anchorTrade"],
      "properties": {
        "costSplit": {
          "oneOf": [
            {
              "allOf": [
                { "$ref": "#/definitions/seriesFigure" },
                {
                  "type": "object",
                  "properties": {
                    "series": {
                      "minItems": 3,
                      "description": "Fewer than three parts is not a split of the cost of standing somewhere."
                    }
                  }
                }
              ]
            },
            { "$ref": "#/definitions/nullFigure" }
          ]
        },
        "sizes": {
          "type": "object",
          "required": ["small", "medium", "large"],
          "properties": {
            "small": { "$ref": "#/definitions/unitSize" },
            "medium": { "$ref": "#/definitions/unitSize" },
            "large": { "$ref": "#/definitions/unitSize" }
          },
          "additionalProperties": false
        },
        "anchorTrade": {
          "oneOf": [
            { "$ref": "#/definitions/anchorTrade" },
            { "$ref": "#/definitions/nullFigure" }
          ]
        },
        "note": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": false
    },

    "tradeEconomics": {
      "type": "object",
      "required": ["trades"],
