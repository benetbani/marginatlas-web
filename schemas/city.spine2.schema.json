            { "$ref": "#/definitions/nullFigure" }
          ]
        }
      },
      "additionalProperties": false
    },

    "watch": {
      "type": "object",
      "required": ["pressures", "localKnowledge"],
      "properties": {
        "pressures": {
          "oneOf": [
            { "$ref": "#/definitions/pressuresFigure" },
            { "$ref": "#/definitions/nullFigure" }
          ]
        },
        "localKnowledge": {
          "oneOf": [
            { "$ref": "#/definitions/localKnowledgeFigure" },
            { "$ref": "#/definitions/nullFigure" }
          ]
