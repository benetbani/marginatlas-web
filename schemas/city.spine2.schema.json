          ]
        },
        "note": { "type": "string", "minLength": 10 },
        "tradeAgainstPeer": {
          "oneOf": [
            { "$ref": "#/definitions/tradeVersusPeerFigure" },
            { "$ref": "#/definitions/nullFigure" }
          ]
