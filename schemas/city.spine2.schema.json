                "districtName": { "type": "string", "minLength": 1 },
                "shareOfSpend": { "$ref": "#/definitions/pointOrNull" }
              },
              "additionalProperties": false
            },
            { "$ref": "#/definitions/nullFigure" }
          ]
        }
      },
      "additionalProperties": false
    },

