# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit it.
#
# Plan v14 Phase F (2026-05-20): scrubbed previously-committed Supabase
# secrets that leaked into git history. Founder must rotate the
# SUPABASE_SERVICE_ROLE_KEY in the Supabase dashboard before deploy.
#
# For the full production env var list, see .env.example at the repo root.

# Supabase Pro
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

