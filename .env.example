# Margin Atlas — production env vars
# Copy this to .env.local for dev OR paste into Vercel
# project settings (Production environment) for the live deploy.
#
# NEVER commit .env.local — only this template ships in git.

# --- Supabase (Pro tier) ---
# Server-side URL + service-role key (full DB access; keep secret).
SUPABASE_URL=https://NNNNN.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Browser-exposed equivalents (anon key only, RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=https://NNNNN.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Unsplash ---
# Production tier preferred; demo key works until approval lands.
UNSPLASH_ACCESS_KEY=XXXX
UNSPLASH_SECRET_KEY=YYYY

# --- Pexels (free) ---
PEXELS_API_KEY=ZZZZ

# --- Anthropic ---
# Powers the Ask Atlas widget and offline content generation.
# In production we route through Vercel AI Gateway (below) for observability.
# Keep ANTHROPIC_API_KEY as a fallback — used when ANTHROPIC_AI_GATEWAY_KEY
# is empty (local dev, or if the gateway is unreachable).
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Vercel AI Gateway (production routing for Ask Atlas) ---
# Sign up at vercel.com/ai-gateway, create a key, paste here.
# When set, the Ask widget routes through https://ai-gateway.vercel.sh
# instead of api.anthropic.com — gives us per-query observability in the
# Vercel dashboard. Same Claude models, same response shape.
ANTHROPIC_AI_GATEWAY_KEY=

# --- Admin gate ---
# Any sufficiently-long random string. Required to access /admin/review.
ADMIN_KEY=any-strong-string

# --- Sentry (production error monitoring) ---
# Public DSN — safe to ship to the browser. Use the EXAMPLE format
# below until you create the project at sentry.io; swap in the real
# value in Vercel env settings before going live.
NEXT_PUBLIC_SENTRY_DSN=https://EXAMPLE@oNNNNN.ingest.sentry.io/PPPPP

# Optional — used by the build to upload source maps. Leave blank to
# skip uploads (build still succeeds). Generate at:
# Sentry → Settings → Auth Tokens → "project:releases" scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Plausible ---
# No env var needed. The data-domain attribute on the script tag in
# src/app/layout.tsx ("www.marginatlas.com") is the only configuration.
